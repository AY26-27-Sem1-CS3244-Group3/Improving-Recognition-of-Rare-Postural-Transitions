    }
   ],
   "source": [
    "EXPLAIN_DIR = MAIN_PATH.parent / \"explainability\"\n",
    "model_checks = json.loads((EXPLAIN_DIR / \"model_checks.json\").read_text())\n",
    "assert model_checks[\"matched_final_predictions\"] == len(y_test)\n",
    "assert model_checks[\"transition_windows\"] == expected_support[6:].sum()\n",
    "assert model_checks[\"final_transition_correct\"] == mlp_class.correct.iloc[6:].sum()\n",
    "\n",
    "window_effects = pd.read_csv(EXPLAIN_DIR / \"window_effects.csv\")\n",
    "joint_effects = pd.read_csv(EXPLAIN_DIR / \"joint_effects.csv\")\n",
    "ig_checks = pd.read_csv(EXPLAIN_DIR / \"ig_checks.csv\")\n",
    "feature_cases = pd.read_csv(EXPLAIN_DIR / \"feature_cases.csv\")\n",
    "surrogate_results = pd.read_csv(EXPLAIN_DIR / \"surrogate_results.csv\")\n",
    "surrogate_cases = pd.read_csv(EXPLAIN_DIR / \"surrogate_cases.csv\")\n",
    "surrogate_refits = pd.read_csv(EXPLAIN_DIR / \"surrogate_refits.csv\")\n",
    "for label, filename, frame in [\n",
    "    (\"Single-window MLP occlusion\", \"window_effects.csv\", window_effects),\n",
    "    (\"Joint MLP occlusion\", \"joint_effects.csv\", joint_effects),\n",
    "    (\"Integrated Gradients checks\", \"ig_checks.csv\", ig_checks),\n",
    "    (\"Case-level feature ablations\", \"feature_cases.csv\", feature_cases),\n",
    "    (\"Local probability surrogate audit\", \"surrogate_results.csv\", surrogate_results),\n",
    "    (\"Row 51 surrogate refits\", \"surrogate_refits.csv\", surrogate_refits),\n",
    "]:\n",
    "    source_registry.append([label, f\"explainability/{filename}\", \"\", \"Computed from fixed MLP\", len(frame)])\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 4))\n",
    "for reference, group in window_effects.groupby(\"reference\", sort=False):\n",
    "    ax.plot(group.offset, group.mean_absolute_drop, marker=\"o\",\n",
    "            label=\"Lying\" if reference == \"Laying\" else reference)\n",
    "ax.set(xlabel=\"Window offset (0 = current)\", ylabel=\"Mean absolute logit-margin change\",\n",
    "       xticks=list(range(-5, 6)))\n",
    "ax.grid(axis=\"y\", alpha=.25)\n",
    "ax.legend()\n",
    "fig.tight_layout()\n",
    "plt.show()"
   ]
  },
