    "\n",
    "    def assignment(name):\n",
    "        matches = assignments.get(name, [])\n",
    "        if len(matches) != 1:\n",
    "            raise ValueError(f\"Expected one source assignment for {name}; found {len(matches)}.\")\n",
    "        return matches[0]\n",
    "\n",
    "    def literal(node):\n",
    "        if isinstance(node, ast.Name):\n",
