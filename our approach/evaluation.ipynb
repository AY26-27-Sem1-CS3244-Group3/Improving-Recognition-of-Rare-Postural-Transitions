    "\n",
    "def collect_source_results(notebook):\n",
    "    cells, assignments, registry, locations = notebook[\"cells\"], {}, [], {}\n",
    "    for index, cell in enumerate(cells):\n",
    "        if cell[\"cell_type\"] != \"code\":\n",
