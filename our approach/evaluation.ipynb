    "lda_predictions = np.asarray(lda_results[\"predictions\"])\n",
    "if (lda_predictions.shape != y_test.shape or not np.issubdtype(lda_predictions.dtype, np.integer)\n",
    "        or not np.isin(lda_predictions, LABELS).all()):\n",
    "    raise ValueError(\"LDA predictions must contain one valid integer label per test window.\")\n",
    "lda_confusion = np.zeros((12, 12), dtype=int)\n",
    "np.add.at(lda_confusion, (y_test - 1, lda_predictions - 1), 1)\n",
    "np.testing.assert_array_equal(lda_confusion, np.asarray(source_results[\"lda_confusion\"]))\n",
    "np.testing.assert_array_equal(lda_confusion.sum(axis=1), expected_support)\n",
    "lda_correct = np.diag(lda_confusion)\n",
    "lda_predicted = lda_confusion.sum(axis=0)\n",
    "lda_precision = np.divide(lda_correct, lda_predicted, out=np.zeros(12, dtype=float), where=lda_predicted != 0)\n",
    "lda_recall = lda_correct / expected_support\n",
    "lda_f1 = 2 * lda_correct / (expected_support + lda_predicted)\n",
    "lda_class = pd.DataFrame({\"Class\": LABELS, \"Activity\": CLASS_NAMES, \"Support\": expected_support,\n",
    "    \"Correct\": lda_correct, \"Precision\": lda_precision, \"Recall\": lda_recall, \"F1\": lda_f1})\n",
    "lda_summary = {\"accuracy\": float(lda_correct.sum() / len(y_test))}\n",
    "aggregate_rows = []\n",
    "for name, prefix, region in [(\"All 12 classes\", \"macro\", slice(None)),\n",
    "                             (\"Common 1–6\", \"common\", slice(0, 6)),\n",
    "                             (\"Transitions 7–12\", \"transition\", slice(6, 12))]:\n",
    "    values = [float(v[region].mean()) for v in [lda_precision, lda_recall, lda_f1]]\n",
    "    aggregate_rows.append([name, *values])\n",
    "    lda_summary.update({f\"{prefix}_{metric}\": value for metric, value in zip([\"precision\", \"recall\", \"f1\"], values)})\n",
    "selected_record = lda_results[\"test_summary\"].set_index(\"pipeline\").loc[\"selected\"]\n",
    "for metric in selected_record.index:\n",
    "    np.testing.assert_allclose(lda_summary[metric], selected_record[metric], atol=1e-15, rtol=0)\n",
    "for metric in [\"transition_f1\", \"transition_recall\", \"common_f1\", \"macro_f1\", \"accuracy\"]:\n",
    "    np.testing.assert_allclose(lda_summary[metric], final_test.loc[\"lda\", metric], atol=0.00005 + 1e-12, rtol=0)\n",
    "np.testing.assert_array_equal(lda_correct, class_recall[\"LDA correct\"].astype(int))\n",
    "np.testing.assert_allclose(lda_recall, class_recall[\"LDA recall\"].str.rstrip(\"%\").astype(float) / 100,\n",
    "                           atol=0.00005 + 1e-12, rtol=0)\n",
    "transition_report = source_results[\"lda_transition\"]\n",
    "np.testing.assert_array_equal(transition_report[\"Class ID\"].astype(int), LABELS[6:])\n",
    "np.testing.assert_array_equal(transition_report[\"Test support\"].astype(int), expected_support[6:])\n",
    "for label, values in [(\"Precision\", lda_precision), (\"Recall\", lda_recall), (\"F1\", lda_f1)]:\n",
    "    np.testing.assert_allclose(values[6:], transition_report[label].astype(float), atol=0.00005 + 1e-12, rtol=0)\n",
    "lda_errors = test_meta.loc[lda_predictions != y_test, [\"subject_id\", \"activity_id\"]].copy()\n",
    "lda_errors[\"predicted\"] = lda_predictions[lda_predictions != y_test]\n",
    "lda_errors = lda_errors.rename_axis(\"test_row\").reset_index().rename(columns={\"subject_id\": \"participant\", \"activity_id\": \"actual\"})\n",
    "lda_transition_errors = lda_errors[lda_errors.actual.ge(7) | lda_errors.predicted.ge(7)].reset_index(drop=True)\n",
    "recorded_cases = source_results[\"lda_cases\"].rename(columns={\"Test row\": \"test_row\", \"Participant\": \"participant\",\n",
    "    \"Actual activity\": \"actual\", \"Predicted activity\": \"predicted\"}).copy()\n",
    "recorded_cases[[\"test_row\", \"participant\"]] = recorded_cases[[\"test_row\", \"participant\"]].astype(int)\n",
    "name_to_id = {name: class_id for class_id, name in class_lookup.items()}\n",
    "recorded_cases[\"actual\"] = recorded_cases.actual.map(name_to_id)\n",
    "recorded_cases[\"predicted\"] = recorded_cases.predicted.map(name_to_id)\n",
    "pd.testing.assert_frame_equal(lda_transition_errors, recorded_cases, check_dtype=False)\n",
    "show_table(pd.DataFrame(aggregate_rows, columns=[\"Scope\", \"Macro precision\", \"Macro recall\", \"Macro F1\"]), decimals=6)"
   ]
